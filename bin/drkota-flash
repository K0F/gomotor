#!/usr/bin/env bash
# drkota-flash — Precompiled manual-reset firmware uploader for Drkota (GoMotor)
# Works both on bazina (directly via avrdude) and from t520 (forwards to bazina if /dev/ttyUSB0 is on bazina).
set -e

PORT="${DRKOTA_PORT:-/dev/ttyUSB0}"
SKETCH_DIR="$HOME/src/gomotor/firmware/drkota_firmware"
BUILD_DIR="/tmp/drkota_build"
HEX_FILE="$BUILD_DIR/drkota_firmware.ino.hex"
MODE="${1:-uno}"

case "$MODE" in
    uno)
        FQBN="arduino:avr:uno"
        BAUD="115200"
        DESC="Arduino Uno / Nano New (ATmega328P, 115200 baud)"
        ;;
    nano-old|old)
        FQBN="arduino:avr:nano:cpu=atmega328old"
        BAUD="57600"
        DESC="Arduino Nano (ATmega328P Old Bootloader, 57600 baud)"
        ;;
    *)
        FQBN="arduino:avr:uno"
        BAUD="115200"
        DESC="Arduino Uno (ATmega328P, 115200 baud)"
        ;;
esac

# If we are on t520, compile fresh .hex and copy to bazina if port is on bazina
if [ -x "$HOME/bin/arduino-cli" ] && [ -d "$HOME/.arduino15" ]; then
    mkdir -p "$BUILD_DIR"
    "$HOME/bin/arduino-cli" compile --fqbn "$FQBN" --output-dir "$BUILD_DIR" "$SKETCH_DIR"
fi

if [ ! -e "$PORT" ] && [ "$(hostname)" != "bazina" ]; then
    ssh bazina "mkdir -p $BUILD_DIR"
    scp -q "$HEX_FILE" "bazina:$HEX_FILE"
    exec ssh -t bazina "/home/kof/bin/drkota-flash $MODE"
fi

echo "============================================================"
echo "     DRKOTA FIRMWARE FLASHER (PERMANENT SERVO ON PIN 11)"
echo "============================================================"
echo "Host:   $(hostname)"
echo "Port:   $PORT ($BAUD baud)"
echo "Target: $DESC"
echo "Hex:    $HEX_FILE"
echo "============================================================"
echo ""
echo "   1. HOLD DOWN the physical RESET button on the Arduino."
echo "   2. Press [ENTER] in this terminal."
echo "   3. Immediately RELEASE the RESET button when you see 'BURNING'!"
echo ""
read -p ">>> HOLD RESET and press [ENTER] to burn... " _unused

echo ""
echo ">>> BURNING! RELEASE RESET BUTTON NOW! <<<"
echo ""

avrdude -v -patmega328p -carduino -P"$PORT" -b"$BAUD" -D -Uflash:w:"$HEX_FILE":i

echo ""
echo "============================================================"
echo "SUCCESS: Permanent-Servo Firmware uploaded to Drkota!"
echo "============================================================"
